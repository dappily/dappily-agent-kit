{
  "specVersion": 4,
  "kitVersion": "0.2.0",
  "sdkVersion": "2.80.0",

  "name": "BURN_TOKEN",
  "description": "Burn fungible tokens, permanently reducing the total supply. The tokens are burned from the treasury account. The token must have been created with a supply key. By default, the agent's operator key is used to sign.",
  "category": "fungible",
  "similes": ["burn token", "burn tokens", "decrease supply", "destroy tokens", "reduce supply"],

  "risk": "destructive",
  "costTier": "low",

  "hedera": {
    "service": "HTS",
    "sdkClass": "TokenBurnTransaction",
    "sdkImports": ["TokenBurnTransaction", "PrivateKey", "Status"],
    "networkCallType": "transaction",
    "requiresSigning": true,
    "requiredKeys": ["operator", "supply"],
    "estimatedFeeHbar": 0.001
  },

  "sdkMethods": [
    { "method": "setTokenId", "args": [{ "from": "input.tokenId" }] },
    { "method": "setAmount", "args": [{ "from": "input.amount" }] },
    { "method": "setTransactionMemo", "args": [{ "from": "input.memo" }], "conditional": { "field": "memo", "when": "provided" } }
  ],

  "implicitBehaviors": [
    {
      "behavior": "Supply key signing via freeze + sign pattern",
      "details": "If supplyPrivateKey is provided, the transaction is frozen with freezeWith() then signed with the supply key. Otherwise operator key signs automatically."
    },
    {
      "behavior": "Receipt provides new total supply",
      "details": "After a successful burn, receipt.totalSupply contains the updated total supply of the token."
    }
  ],

  "inputs": [
    {
      "name": "tokenId",
      "type": "string",
      "required": true,
      "constraints": { "regex": "^\\d+\\.\\d+\\.\\d+$" },
      "describe": "The token ID to burn (e.g. 0.0.99999)"
    },
    {
      "name": "amount",
      "type": "number",
      "required": true,
      "constraints": { "min": 1 },
      "describe": "Amount of tokens to burn (in smallest unit)"
    },
    {
      "name": "memo",
      "type": "string",
      "required": false,
      "constraints": { "max": 100 },
      "describe": "Optional memo for the transaction"
    },
    {
      "name": "supplyPrivateKey",
      "type": "string",
      "required": false,
      "describe": "Supply key for the token (only needed if different from operator key)"
    }
  ],

  "preflightChecks": [
    {
      "check": "Treasury has enough tokens to burn",
      "type": "balance",
      "failError": "INSUFFICIENT_TOKEN_BALANCE",
      "failDetails": "Cannot burn more tokens than the treasury holds."
    },
    {
      "check": "Warn on large burns (>= 1,000,000 units)",
      "type": "amount_threshold",
      "failError": "LARGE_BURN_WARNING",
      "failDetails": "Large burn detected. This is permanent and irreversible."
    }
  ],

  "successData": [
    { "name": "tokenId", "type": "string", "source": "input", "describe": "The burned token ID" },
    { "name": "amountBurned", "type": "number", "source": "input", "describe": "Amount of tokens burned" },
    { "name": "newTotalSupply", "type": "string", "source": "receipt", "receiptField": "totalSupply", "describe": "New total supply after burning" },
    { "name": "explorerUrl", "type": "string", "source": "computed", "describe": "HashScan transaction URL via agent.getExplorerUrl(txId)" }
  ],

  "errorMap": [
    { "hederaStatus": "TOKEN_HAS_NO_SUPPLY_KEY", "error": "TOKEN_HAS_NO_SUPPLY_KEY", "details": "This token was created without a supply key. Burning is permanently disabled." },
    { "hederaStatus": "INSUFFICIENT_TOKEN_BALANCE", "error": "INSUFFICIENT_TOKEN_BALANCE", "details": "Cannot burn more tokens than the treasury holds." },
    { "hederaStatus": "INVALID_SIGNATURE", "error": "INVALID_SIGNATURE", "details": "Transaction signature is invalid. The supply key doesn't match." },
    { "hederaStatus": "INVALID_TOKEN_ID", "error": "INVALID_TOKEN_ID", "details": "The token ID does not exist on this network." },
    { "hederaStatus": "TOKEN_WAS_DELETED", "error": "TOKEN_WAS_DELETED", "details": "This token has been deleted." },
    { "hederaStatus": "INSUFFICIENT_PAYER_BALANCE", "error": "INSUFFICIENT_PAYER_BALANCE", "details": "Not enough HBAR to cover the transaction fee." }
  ],

  "requiresConfirmation": true,
  "hasSimulation": true,
  "irreversible": true
}
